# HUAU Sports local development - never commit real secrets.
APP_ENV=development
APP_VERSION=0.9.0-phase8-explanation
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PLATFORM_ADMIN_EMAILS=you@example.com

# Phase 7 Payments. Keep real values in Cloudflare secrets / local untracked env only.
MERCADO_PAGO_CLIENT_ID=replace-me-locally
MERCADO_PAGO_CLIENT_SECRET=replace-me-locally
MERCADO_PAGO_WEBHOOK_SECRET=replace-me-locally
MERCADO_PAGO_REDIRECT_URI=http://localhost:5173/api/payments/mercado-pago/oauth/callback
PAYMENT_ENCRYPTION_KEY=replace-with-base64-32-byte-key
